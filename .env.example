# ---- Addresses ----
# The product's own domain. Venues live at <name>.<SCREENS_DOMAIN>
APP_URL="https://digitalsignage.myqr.co.nz"
SCREENS_DOMAIN="digitalsignage.myqr.co.nz"
BRAND_NAME="myQR"
PRODUCT_NAME="Digital Signage"
SUPPORT_EMAIL="hello@myqr.co.nz"

# ---- Database (can be the same Neon database as the admin; tables start with ds_) ----
DATABASE_URL="postgres://user:pass@host/db?sslmode=require"

# ---- Stripe ----
STRIPE_SECRET_KEY="rk_live_..."
STRIPE_WEBHOOK_SECRET="whsec_..."        # this app's own webhook endpoint
STRIPE_PRICE_MONTHLY="price_..."
STRIPE_PRICE_YEARLY="price_..."
PRICE_MONTHLY_LABEL="$39 a month"
PRICE_YEARLY_LABEL="$399 a year"
TRIAL_DAYS="0"                            # e.g. 14 for a free trial

# ---- Advert storage (Vercel → Storage → Blob, then connect to this project) ----
BLOB_READ_WRITE_TOKEN=""

# ---- Email (resend.com) ----
RESEND_API_KEY=""
FROM_EMAIL="Digital Signage <hello@myqr.co.nz>"

# ---- Admin connection (copy from the admin's Products → Digital Signage page) ----
HQ_URL="https://admin.myqr.co.nz"
HQ_PRODUCT="signage"
HQ_SECRET=""

# ---- Cron ----
CRON_SECRET=""
